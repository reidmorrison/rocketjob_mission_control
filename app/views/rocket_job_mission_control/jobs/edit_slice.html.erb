<div class='row'>
  <div class='col-md-12'>
    <div class="card">
      <div class="card-header page-title-bar">
        <h2 class='page-title'>
          <%= link_to(@job.class.name, job_path(@job)) %> Edit Slice
        </h2>
      </div>
    </div>

    <div class='job-status'>
      <div class='section-header'>Edit Record: <%= @first_record_number + @line_index %></div>

      <% record = @lines[@line_index] %>
      <p class='form-text'>
        <% if record.is_a?(String) %>
          Unprintable bytes are shown as <code>\xHH</code> escapes (for example a null byte as <code>\x00</code>)
          and are converted back to the original bytes when saved. A literal backslash is shown as <code>\\</code>.
        <% else %>
          This record is not text, so it is shown as MongoDB Extended JSON, and saved with the same types of values.
          For example <code>{"$date": "..."}</code> is saved as a time.
        <% end %>
      </p>

      <%= form_for(:job, url: update_slice_job_path(@job, offset: @offset, error_type: @failure_exception.class_name, line_index: @line_index), method: :patch) do |f| %>
        <%= f.text_area :record, value: escape_record(record), class: 'input_slices form-control', id: @line_index, rows: 20, wrap: "soft" %>

        <div id='submit'>
          <%= f.submit 'Save', class: 'btn btn-primary' %>
          <%= link_to 'Delete', delete_line_job_path(@job, offset: @offset, error_type: @failure_exception.class_name, line_index: @line_index), data: {turbo_method: :patch, turbo_confirm: "Record #{@first_record_number + @line_index} will be deleted from the slice. Are you sure?"}, class: 'btn btn-danger' %>
          <%= link_to 'Cancel', view_slice_job_path(@job, error_type: @failure_exception.class_name, record_number: @job.input.failed.first.processing_record_number), class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
